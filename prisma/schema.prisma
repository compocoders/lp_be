generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile          Profile?
  classrooms       Classroom[]
  learningMaterials LearningMaterial[]
  userClassrooms   classroomUser[]
  createdActivities Activity[]   @relation("ActivityCreator")
  submissions      Submission[]
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  profilePicture String?
  firstName      String?
  lastName       String?
  status         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Classroom {
  id           String   @id @default(uuid())
  name         String
  description  String?
  userId       String
  status       String   @default("active")
  private      Boolean  @default(false)
  roomCode     String   @unique
  roompassword String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classroomUsers   classroomUser[]
  User             User              @relation(fields: [userId], references: [id])
  LearningMaterial LearningMaterial[]
  activities       Activity[]
}

model classroomUser {
  id          String   @id @default(uuid())
  classroomId String
  userId      String
  role        String   @default("student")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Classroom Classroom @relation(fields: [classroomId], references: [id])
  User      User      @relation(fields: [userId], references: [id])

  @@unique([classroomId, userId])
}

model LearningMaterial {
  id          String   @id @default(uuid())
  classroomId String
  userId      String
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Classroom Classroom @relation(fields: [classroomId], references: [id])
  User      User      @relation(fields: [userId], references: [id])
}

// ─── ACTIVITY SYSTEM ────────────────────────────────────────────────────────

/// Supported activity types (stored as string for extensibility)
/// QUIZ | CODING | FRONTEND | SPREADSHEET | ESSAY | PROBLEM_SET | PRESENTATION
model Activity {
  id           String    @id @default(uuid())
  classroomId  String
  createdBy    String
  title        String
  description  String?
  activityType String                       // QUIZ | CODING | FRONTEND | SPREADSHEET | ESSAY | PROBLEM_SET | PRESENTATION
  status       String    @default("draft")  // draft | published | closed
  deadline     DateTime?
  totalPoints  Int       @default(100)
  allowLate    Boolean   @default(false)    // teacher toggle: accept late submissions
  maxAttempts  Int       @default(1)        // 1 = once-and-locked; teacher can allow retries
  config       Json?                        // activity-type-specific config (compiler language, word limit, etc.)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  Classroom   Classroom    @relation(fields: [classroomId], references: [id])
  Creator     User         @relation("ActivityCreator", fields: [createdBy], references: [id])
  questions   Question[]
  submissions Submission[]
}

/// Supported question types (stored as string)
/// multiple_choice | checkbox | short_answer | essay | coding_problem | frontend_problem | spreadsheet_problem | file_upload
model Question {
  id           String   @id @default(uuid())
  activityId   String
  questionType String                        // multiple_choice | checkbox | short_answer | essay | coding_problem | frontend_problem | spreadsheet_problem | file_upload
  content      String                        // question text or problem statement
  options      Json?                         // [{ id, text }] for MC / checkbox
  correctAnswer Json?                        // MC: option id; checkbox: [ids]; short_answer: string (for auto-grade)
  points       Int      @default(10)
  order        Int      @default(0)
  config       Json?                         // per-question config (test cases for coding, rubric for essay, etc.)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  answers  Answer[]
}

model Submission {
  id          String    @id @default(uuid())
  activityId  String
  studentId   String
  attemptNumber Int     @default(1)
  status      String    @default("submitted")   // submitted | graded | late
  totalScore  Int?
  maxScore    Int?                              // snapshot of totalPoints at time of submission
  feedback    String?                           // overall feedback from teacher
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?
  updatedAt   DateTime  @updatedAt

  Activity Activity @relation(fields: [activityId], references: [id])
  Student  User     @relation(fields: [studentId], references: [id])
  answers  Answer[]

  @@unique([activityId, studentId, attemptNumber])
  @@index([activityId])
  @@index([studentId])
}

model Answer {
  id           String   @id @default(uuid())
  submissionId String
  questionId   String
  content      Json                           // flexible: { text } | { selectedIds: [] } | { code, language, output } | { fileUrl }
  score        Int?                           // points awarded for this answer (null = not yet graded)
  feedback     String?                        // per-answer teacher feedback
  isAutoGraded Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  Question   Question   @relation(fields: [questionId], references: [id])
}